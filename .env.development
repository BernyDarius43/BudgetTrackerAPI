# Development defaults (do not commit real secrets)
NODE_ENV=development
ENV_VALIDATE_STRICT=false
PORT=5000
CORS_ORIGINS=http://localhost:3000

# API
URL_API=/api/v1
URL_DEV=/api/v1

# MongoDB
MONGODB_URI_DEV=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/budgettracker_dev?retryWrites=true&w=majority
# Optional canonical name (recommended to update code to use this)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/budgettracker_dev?retryWrites=true&w=majority

# JWT
JWT_SECRET=change-me-development

# Firebase Admin SDK (choose ONE method)
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
