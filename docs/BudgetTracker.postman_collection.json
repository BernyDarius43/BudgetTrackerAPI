              ],
              "path": [
                "api",
                "v1",
                "delete-expense",
                "{{expense_id}}"
              ]
            },
            "description": "Deletes an expense by ID. Run 'Create Expense' first to populate {{expense_id}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.environment.unset('expense_id');"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Expense - Missing Required Fields (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebase_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/add-expense",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "add-expense"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Missing amount and date\"\n}"
            },
            "description": "Negative test - should return 400 when required fields are missing."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rejects incomplete payload', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
