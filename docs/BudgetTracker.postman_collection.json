              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns an array', () => {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "pm.test('Each item has required fields', () => {",
                  "  const items = pm.response.json();",
                  "  if (items.length > 0) {",
                  "    pm.expect(items[0]).to.have.property('_id');",
                  "    pm.expect(items[0]).to.have.property('title');",
                  "    pm.expect(items[0]).to.have.property('amount');",
                  "    pm.expect(items[0]).to.have.property('category');",
                  "    pm.expect(items[0]).to.have.property('date');",
                  "    // save first id for downstream tests",
                  "    pm.environment.set('income_id', items[0]._id);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
